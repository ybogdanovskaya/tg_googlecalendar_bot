# This is a value-free template. Put real values only into the ignored
# /etc/calendar-miniapp-preview/calendar-miniapp-preview.env on the VPS.
BOT_TOKEN_FILE=/etc/calendar-miniapp-preview/telegram.token
ADMIN_TELEGRAM_ID=replace_on_server
GOOGLE_CALENDAR_ID=primary
APPS_SCRIPT_URL_FILE=/etc/calendar-miniapp-preview/google_apps_script.url
APPS_SCRIPT_SECRET_FILE=/etc/calendar-miniapp-preview/google_apps_script.secret
DATABASE_PATH=/var/lib/calendar-miniapp-preview/calendar_preview.sqlite3
LOG_PATH=/var/log/calendar-miniapp-preview/calendar_preview.jsonl
TIMEZONE=Europe/Moscow
MIN_LEAD_MINUTES=120
BOOKING_HORIZON_DAYS=90
HOLD_HOURS=24
PRIVACY_POLICY_VERSION=2026-08-07
MINIAPP_API_BIND_HOST=127.0.0.1
MINIAPP_API_BIND_PORT=8002
MINIAPP_COOKIE_SECURE=true
# Keep the BotFather Web App menu button for the test bot. The preview bot is
# used for polling and notifications only, so it must not replace that button.
BOT_CONFIGURE_MENU=false
