[Unit]
Description=Backup Telegram Calendar Bot SQLite database

[Service]
Type=oneshot
User=calendarbot
Group=calendarbot
WorkingDirectory=/opt/calendar-bot
ExecStart=/opt/calendar-bot/.venv/bin/python scripts/backup.py --database /var/lib/calendar-bot/calendar_bot.sqlite3 --destination /var/lib/calendar-bot/backups --keep-days 30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/calendar-bot
UMask=0077
