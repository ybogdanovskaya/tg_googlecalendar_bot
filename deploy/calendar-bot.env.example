BOT_TOKEN_FILE=/etc/calendar-bot/telegram.token
ADMIN_TELEGRAM_ID=replace_on_server
GOOGLE_CALENDAR_ID=primary
GOOGLE_TOKEN_FILE=/var/lib/calendar-bot/google_token.json
APPS_SCRIPT_URL=
APPS_SCRIPT_URL_FILE=/etc/calendar-bot/google_apps_script.url
APPS_SCRIPT_SECRET_FILE=/etc/calendar-bot/google_apps_script.secret
DATABASE_PATH=/var/lib/calendar-bot/calendar_bot.sqlite3
LOG_PATH=/var/log/calendar-bot/calendar_bot.jsonl
TIMEZONE=Europe/Moscow
MIN_LEAD_MINUTES=120
BOOKING_HORIZON_DAYS=30
HOLD_HOURS=24
PRIVACY_POLICY_VERSION=2026-08-07
