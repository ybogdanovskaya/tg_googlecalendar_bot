# Supplemental, value-free Mini App configuration for production.
# This file is loaded after /etc/calendar-bot/calendar-bot.env.
# Keep it only on the VPS as /etc/calendar-bot/calendar-miniapp.env.
LOG_PATH=/var/log/calendar-bot/miniapp_api.jsonl
MINIAPP_API_BIND_HOST=127.0.0.1
MINIAPP_API_BIND_PORT=8001
MINIAPP_COOKIE_SECURE=true
