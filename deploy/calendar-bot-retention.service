[Unit]
Description=Apply Telegram Calendar Bot data retention
After=calendar-bot-backup.service

[Service]
Type=oneshot
User=calendarbot
Group=calendarbot
WorkingDirectory=/opt/calendar-bot
Environment=PYTHONPATH=/opt/calendar-bot
ExecStart=/opt/calendar-bot/.venv/bin/python scripts/retention.py --database /var/lib/calendar-bot/calendar_bot.sqlite3 --days 365
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/calendar-bot /var/log/calendar-bot
UMask=0077
